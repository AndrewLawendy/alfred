{
  "id": "/",
  "short_name": "Alfred",
  "name": "Alfred — Your own wardrobe stylist",
  "description": "Your wardrobe, your outfits in rotation, and a jacket when the weather calls for one.",
  "categories": ["lifestyle", "shopping"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/manifest-icon-192.maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/manifest-icon-512.maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#EEEDE9",
  "background_color": "#EEEDE9",
  "shortcuts": [
    {
      "name": "Pick today's",
      "short_name": "Pick",
      "url": "/?action=next",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New outfit",
      "url": "/outfits?outfit=new",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Add to wardrobe",
      "short_name": "Add",
      "url": "/wardrobe?add=1",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "photo", "accept": ["image/*"] }]
    }
  }
}
