{
  "name": "alfred",
  "version": "2.2.0",
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "^2.3.4",
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@fontsource/bodoni-moda": "^5",
    "@types/node": "^24",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "firebase": "^9.23.0",
    "framer-motion": "^7.5.1",
    "lodash.omit": "^4.5.0",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.0.3",
    "react-icons": "^4.4.0",
    "react-image-file-resizer": "^0.4.8",
    "workbox-cacheable-response": "^7.4",
    "workbox-core": "^7.4",
    "workbox-expiration": "^7.4",
    "workbox-precaching": "^7.4",
    "workbox-routing": "^7.4",
    "workbox-strategies": "^7.4",
    "wouter": "^2.8.0-alpha.2"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5055",
    "test": "vitest",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore,storage --project alfred-rules-test \"node --test rules.test.mjs\"",
    "lint": "eslint src --fix --cache --quiet",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "deploy": "firebase deploy --only hosting",
    "update": "yarn build && yarn deploy"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "yarn lint"
    ],
    "*.{js,jsx,ts,tsx,css,html,md,yml,json,eslintrc,prettierrc}": [
      "yarn format"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@eslint/js": "^9",
    "@firebase/rules-unit-testing": "2.0.7",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16.3",
    "@types/lodash.omit": "^4.5.7",
    "@types/react-beautiful-dnd": "^13.1.2",
    "@vitejs/plugin-react": "^6.1",
    "@vitest/coverage-v8": "^5",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsx-a11y": "^6.10",
    "eslint-plugin-react": "^7.37",
    "eslint-plugin-react-hooks": "^7.1",
    "globals": "^17",
    "husky": "^8.0.1",
    "jsdom": "^29",
    "lint-staged": "^13.0.3",
    "prettier": "^3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71",
    "vite": "^8.3",
    "vite-plugin-pwa": "^1.3",
    "vitest": "^5.0",
    "workbox-build": "^7.4",
    "workbox-window": "^7.4"
  },
  "type": "module"
}
