rules_version = '2';

// Each person reads and writes only their own outfits, items, reminder and
// settings.
// The morning reminder function uses admin access, so these don't apply to it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function owns(data) {
      return isSignedIn() && data.user == request.auth.uid;
    }

    match /{collection}/{id} {
      // A missing document reads as "no longer exists" instead of an error
      allow read: if isOwnedCollection(collection)
        && (resource == null || owns(resource.data));
      allow create: if isOwnedCollection(collection)
        && owns(request.resource.data);
      allow update: if isOwnedCollection(collection)
        && owns(resource.data) && owns(request.resource.data);
      allow delete: if isOwnedCollection(collection) && owns(resource.data);
    }

    function isOwnedCollection(collection) {
      return collection in ["outfits", "wardrobe-items"];
    }

    // Stored under the owner's id
    match /reminders/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Laundry limits, stored under the owner's id
    match /settings/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
